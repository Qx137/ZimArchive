/**
 * @fileoverview Firestore Security Rules for ZimArchive.
 *
 * Core Philosophy:
 * This ruleset enforces public read access for all data. Writes are closed by
 * default because the app has no authentication flow yet — every page only
 * reads from Firestore. If an admin/editing flow is added later, replace the
 * `if false` below with a check against an authenticated admin user.
 *
 * Data Structure:
 * The database consists of top-level collections for `presidents`, `political_parties`,
 * `achievements`, `categories`, `timeline_events`, and `images`. There is no user-specific data.
 *
 * Key Security Decisions:
 * - Public Read Access: All `get` and `list` operations are allowed for all collections.
 * - No Public Write Access: All `create`, `update`, and `delete` operations are denied.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to presidents. Writes are closed.
     * @path /presidents/{presidentId}
     */
    match /presidents/{presidentId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to political parties. Writes are closed.
     * @path /political_parties/{politicalPartyId}
     */
    match /political_parties/{politicalPartyId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to achievements. Writes are closed.
     * @path /achievements/{achievementId}
     */
    match /achievements/{achievementId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to categories. Writes are closed.
     * @path /categories/{categoryId}
     */
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to timeline events. Writes are closed.
     * @path /timeline_events/{timelineEventId}
     */
    match /timeline_events/{timelineEventId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to images. Writes are closed.
     * @path /images/{imageId}
     */
    match /images/{imageId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}
