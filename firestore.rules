/**
 * @fileoverview Firestore Security Rules for ZimArchive.
 *
 * Core Philosophy:
 * This ruleset enforces public read access for all data.
 * Write access is completely open, meaning anyone can create, update, and delete documents.
 *
 * Data Structure:
 * The database consists of top-level collections for `presidents`, `political_parties`,
 * `achievements`, `categories`, `timeline_events`, and `images`. There is no user-specific data.
 *
 * Key Security Decisions:
 * - Public Read Access: All `get` and `list` operations are allowed for all collections.
 * - Unrestricted Write Access: All `create`, `update`, and `delete` operations are allowed for all collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read and write access to presidents.
     * @path /presidents/{presidentId}
     * @allow (get, list) - Any user can read president data.
     * @allow (create, update, delete) - Any user can write president data.
     * @principle Allows public access to president data.
     */
    match /presidents/{presidentId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows public read and write access to political parties.
     * @path /political_parties/{politicalPartyId}
     * @allow (get, list) - Any user can read political party data.
     * @allow (create, update, delete) - Any user can write political party data.
     * @principle Allows public access to political party data.
     */
    match /political_parties/{politicalPartyId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows public read and write access to achievements.
     * @path /achievements/{achievementId}
     * @allow (get, list) - Any user can read achievement data.
     * @allow (create, update, delete) - Any user can write achievement data.
     * @principle Allows public access to achievement data.
     */
    match /achievements/{achievementId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows public read and write access to categories.
     * @path /categories/{categoryId}
     * @allow (get, list) - Any user can read category data.
     * @allow (create, update, delete) - Any user can write category data.
     * @principle Allows public access to category data.
     */
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows public read and write access to timeline events.
     * @path /timeline_events/{timelineEventId}
     * @allow (get, list) - Any user can read timeline event data.
     * @allow (create, update, delete) - Any user can write timeline event data.
     * @principle Allows public access to timeline event data.
     */
    match /timeline_events/{timelineEventId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows public read and write access to images.
     * @path /images/{imageId}
     * @allow (get, list) - Any user can read image data.
     * @allow (create, update, delete) - Any user can write image data.
     * @principle Allows public access to image data.
     */
    match /images/{imageId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
  }
}